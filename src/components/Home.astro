---
import Base from '../layouts/Base.astro';
import Mark from './Mark.astro';
import LaunchMark from './LaunchMark.astro';
import MockApp from './MockApp.astro';
import RefMock from './RefMock.astro';
import Icon from './Icon.astro';
import GetTangent from './GetTangent.astro';
import Footer from './Footer.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import PointDemo from './PointDemo.astro';
import { dicts, type Locale } from '../i18n';
import { release } from '../lib/release';
import { MEDIA_BASE } from '../lib/media';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = dicts[locale];
const other = dicts[t.lang_switch.target as Locale];

// Story order: the promise (pointing at what to change), the problem and a turn of the app,
// pointing instead of describing (what sets Tangent apart), how it works, what you can do,
// what comes out, what you need to run it, what it costs and where to download it,
// then the call to action.
const nav = [
  ['#how', t.nav.how],
  ['#features', t.nav.features],
  ['#sources', t.nav.sources],
  ['#get', t.nav.get],
];
---
<Base locale={locale}>
  <a class="skip" href="#main">{t.skip}</a>

  <header class="site-header">
    <a class="brand" href={t.path} aria-label={t.nav.home}><Mark size={30} /><span>Tangent</span></a>
    <nav aria-label={t.nav.label} class="site-nav">
      {nav.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <div class="header-actions">
      <ThemeSwitch t={t.theme} />
      <a class="lang" href={other.path} hreflang={other.htmlLang} lang={other.htmlLang} aria-label={t.lang_switch.aria}>{t.lang_switch.label}</a>
      <a class="btn btn-primary btn-sm" href="#get">{t.cta}</a>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-inner">
        <div class="hero-mark">
          <LaunchMark class="hero-launch" />
          <h1 id="hero-title" class="wordmark">Tangent</h1>
        </div>
        <p class="eyebrow">{t.hero.eyebrow} · v{release.version}</p>
        <div class="hero-copy">
          <p class="lede">{t.hero.lede}</p>
          <div class="cta-row">
            <a class="btn btn-primary btn-lg" href="#get">{t.cta}</a>
            <a class="btn btn-ghost btn-lg" href="#how">{t.hero.secondary}</a>
          </div>
          <p class="hero-needs">{t.hero.needs}</p>
        </div>
      </div>
      <a class="scroll-cue" href="#intro" aria-label={t.hero.scroll}><Icon name="arrow" /></a>
    </section>

    <section id="intro" class="section statement" aria-labelledby="intro-title">
      <div class="narrow" data-reveal>
        <p class="kicker">{t.intro.kicker}</p>
        <h2 id="intro-title">{t.intro.title}</h2>
        <p class="body-lg">{t.intro.body}</p>
      </div>
      <div class="wide" data-reveal>
        <MockApp t={t.mock} />
        <p class="mock-caption">{t.mock.caption}</p>
      </div>
    </section>

    <section id="point" class="section" aria-labelledby="point-title">
      <div class="point-split wide">
        <div class="point-copy" data-reveal>
          <p class="kicker">{t.point.kicker}</p>
          <h2 id="point-title">{t.point.title}</h2>
          <p class="body-lg">{t.point.body}</p>
          <dl class="point-compare">
            <div><dt>{t.point.without}</dt><dd class="point-without">{t.point.withoutText}</dd></div>
            <div><dt>{t.point.with}</dt><dd>{t.point.before} <span class="chip">@{t.point.chip}</span> {t.point.after}</dd></div>
          </dl>
        </div>
        <div data-reveal><PointDemo t={t.point} /></div>
      </div>
    </section>

    <section id="how" class="section" aria-labelledby="how-title">
      <div class="narrow center" data-reveal>
        <p class="kicker">{t.how.kicker}</p>
        <h2 id="how-title">{t.how.title}</h2>
      </div>
      <div class="how-grid wide" data-how data-reveal>
        <div class="how-tabs" role="tablist" aria-label={t.how.tablist} data-glow>
          {t.how.steps.map((s, i) => (
            <button type="button" class="card how-tab" role="tab" id={`how-tab-${i}`} aria-controls="how-stage" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <span class="step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </button>
          ))}
        </div>
        <div class="how-stage-wrap">
          <div class="how-stage" id="how-stage" role="tabpanel" aria-labelledby="how-tab-0">
            {t.how.steps.map((s) => (
              <video class="how-vid" muted loop playsinline controls preload="none" width={s.video.w} height={s.video.h}
                poster={`/videos/${s.video.name}.jpg`} src={`${MEDIA_BASE}${s.video.file}`} aria-label={s.video.label}></video>
            ))}
            <button type="button" class="how-toggle" data-state="paused" data-play={t.how.player.play} data-pause={t.how.player.pause} aria-label={t.how.player.play}>
              <svg class="i-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
              <svg class="i-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor" /></svg>
            </button>
          </div>
          <p class="how-caption" aria-live="polite">{t.how.steps[0].body}</p>
        </div>
      </div>
    </section>

    <section id="features" class="section" aria-labelledby="features-title">
      <div class="narrow center" data-reveal>
        <p class="kicker">{t.features.kicker}</p>
        <h2 id="features-title">{t.features.title}</h2>
      </div>
      <ul class="grid-3 wide" data-glow>
        {t.features.items.map((f, i) => (
          <li class="card feature" data-reveal style={`--i:${i % 3}`}>
            <span class="feature-icon"><Icon name={f.icon} /></span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="reference" class="section" aria-labelledby="reference-title">
      <div class="ref-split wide">
        <div class="ref-copy" data-reveal>
          <p class="kicker">{t.reference.kicker}</p>
          <h2 id="reference-title">{t.reference.title}</h2>
          <p class="body-lg">{t.reference.body}</p>
        </div>
        <div data-reveal><RefMock t={t.reference} mock={t.mock} /></div>
      </div>
    </section>

    <section id="export" class="section" aria-labelledby="export-title">
      <div class="narrow center" data-reveal>
        <p class="kicker">{t.export.kicker}</p>
        <h2 id="export-title">{t.export.title}</h2>
      </div>
      <dl class="exports wide" data-reveal>
        {t.export.items.map((x, i) => (
          <div class={i === t.export.items.length - 1 ? 'export export-bambu' : 'export'}>
            <dt>{x.name}</dt>
            <dd>{x.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section id="sources" class="section" aria-labelledby="sources-title">
      <div class="narrow center" data-reveal>
        <p class="kicker">{t.sources.kicker}</p>
        <h2 id="sources-title">{t.sources.title}</h2>
        <p class="body-lg">{t.sources.body}</p>
      </div>
      <div class="sources wide" data-reveal>
        {t.sources.groups.map((g) => (
          <div class="source-group">
            <h3 class="mono-label">{g.title}</h3>
            <ul class="pills">{g.items.map((s) => <li>{s}</li>)}</ul>
          </div>
        ))}
      </div>
      <ul class="trust wide">
        {t.sources.trust.map((x, i) => (
          <li data-reveal style={`--i:${i}`}>
            <span class="feature-icon"><Icon name={i === 0 ? 'lock' : 'shield'} /></span>
            <div><h3>{x.title}</h3><p>{x.body}</p></div>
          </li>
        ))}
      </ul>
      <section class="usage wide" data-reveal aria-labelledby="usage-title">
        <h3 id="usage-title">{t.sources.usage.title}</h3>
        <p class="usage-sub">{t.sources.usage.body}</p>
        <ul class="usage-stats">
          {t.sources.usage.stats.map((x) => (
            <li><strong>{x.big}</strong><span>{x.label}</span><p>{x.sub}</p></li>
          ))}
        </ul>
        <figure class="strips">
          <figcaption>{t.sources.usage.strips.caption}</figcaption>
          {t.sources.usage.strips.scenarios.map((sc) => {
            const wordsTotal = (6 + sc.retries) * 100;
            const tangentTotal = 6 * 117;
            return (
              <div class="strip-group">
                <p class="strip-head"><span>{sc.name}</span><b>{sc.verdict}</b></p>
                <div class="strip-row">
                  <span class="strip-label">{t.sources.usage.strips.words}</span>
                  <div class="strip" style={`--len:${(wordsTotal / 900) * 100}%`} role="img" aria-label={`${t.sources.usage.strips.words}: ${wordsTotal / 600 * 100}%`}>
                    {Array.from({ length: 6 }).map(() => <i class="blk plain"></i>)}
                    {Array.from({ length: sc.retries }).map(() => <i class="blk retry" title={t.sources.usage.strips.retry}></i>)}
                  </div>
                </div>
                <div class="strip-row">
                  <span class="strip-label">{t.sources.usage.strips.tangent}</span>
                  <div class="strip" style={`--len:${(tangentTotal / 900) * 100}%`} role="img" aria-label={`${t.sources.usage.strips.tangent}: ${Math.round(tangentTotal / 6)}%`}>
                    {Array.from({ length: 6 }).map(() => <i class="blk tangent"></i>)}
                  </div>
                </div>
              </div>
            );
          })}
          <p class="strip-legend"><i class="blk retry"></i>{t.sources.usage.strips.retry}</p>
        </figure>
        <details class="usage-fine">
          <summary>{t.sources.usage.fine.summary}</summary>
          <ul>{t.sources.usage.fine.items.map((n) => <li>{n}</li>)}</ul>
        </details>
      </section>
    </section>

    <GetTangent t={t.get} />

    <section class="final" aria-labelledby="final-title">
      <div class="final-inner" data-reveal>
        <LaunchMark class="final-launch" />
        <h2 id="final-title">{t.final.title}</h2>
        <p class="body-lg">{t.final.body}</p>
        <a class="btn btn-primary btn-lg" href="#get">{t.cta}</a>
      </div>
    </section>
  </main>

  <Footer t={t} />
</Base>

<script>
  // How it works: one stage, four silent screen recordings. Plays the chosen one while the stage is on
  // screen; stays still for "reduce motion" until the viewer presses play. Without JS all four show in a list.
  const root = document.querySelector<HTMLElement>('[data-how]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const vids = [...root.querySelectorAll<HTMLVideoElement>('.how-vid')];
    const stage = root.querySelector<HTMLElement>('.how-stage')!;
    const toggle = root.querySelector<HTMLButtonElement>('.how-toggle')!;
    const caption = root.querySelector<HTMLElement>('.how-caption')!;
    let current = 0;
    let onScreen = false;
    let wantsPlay = !matchMedia('(prefers-reduced-motion: reduce)').matches;

    const sync = () => {
      const v = vids[current];
      if (onScreen && wantsPlay) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause();
      const playing = onScreen && wantsPlay;
      toggle.dataset.state = playing ? 'playing' : 'paused';
      toggle.setAttribute('aria-label', playing ? toggle.dataset.pause! : toggle.dataset.play!);
    };
    const show = (i: number, user = false) => {
      current = i;
      if (user) wantsPlay = true;
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      vids.forEach((v, k) => { v.hidden = k !== i; if (k !== i) v.pause(); });
      stage.setAttribute('aria-labelledby', tabs[i].id);
      caption.textContent = tabs[i].querySelector('p')!.textContent;
      vids[i].currentTime = 0;
      sync();
    };

    vids.forEach((v) => (v.controls = false));
    stage.classList.add('is-ready');
    show(0);
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i, true));
      t.addEventListener('keydown', (e) => {
        const next = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
        const target = e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : next ? (i + next + tabs.length) % tabs.length : -1;
        if (target < 0) return;
        e.preventDefault();
        tabs[target].focus();
        show(target, true);
      });
    });
    toggle.addEventListener('click', () => { wantsPlay = !(onScreen && wantsPlay); sync(); });
    new IntersectionObserver(([entry]) => { onScreen = entry.isIntersecting; sync(); }, { threshold: 0.4 }).observe(stage);
  }
</script>
