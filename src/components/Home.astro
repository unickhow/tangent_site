---
import Base from '../layouts/Base.astro';
import Mark from './Mark.astro';
import LaunchMark from './LaunchMark.astro';
import MockApp from './MockApp.astro';
import RefMock from './RefMock.astro';
import ExampleArt from './ExampleArt.astro';
import Icon from './Icon.astro';
import DownloadButton from './DownloadButton.astro';
import { dicts, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = dicts[locale];
const other = dicts[t.lang_switch.target as Locale];

// Story order: the promise, the problem and a turn of the app, how it works, what you can do,
// real examples, what comes out, what you need to run it, then the call to action.
const nav = [
  ['#how', t.nav.how],
  ['#features', t.nav.features],
  ['#examples', t.nav.examples],
  ['#sources', t.nav.sources],
];
---
<Base locale={locale}>
  <a class="skip" href="#main">{t.skip}</a>

  <header class="site-header">
    <a class="brand" href={t.path} aria-label={t.nav.home}><Mark size={30} /><span>Tangent</span></a>
    <nav aria-label={t.nav.label} class="site-nav">
      {nav.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="lang" href={other.path} hreflang={other.htmlLang} lang={other.htmlLang} aria-label={t.lang_switch.aria}>{t.lang_switch.label}</a>
      <DownloadButton label={t.download} size="sm" />
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-inner">
        <div class="hero-mark">
          <LaunchMark class="hero-launch" />
          <h1 id="hero-title" class="wordmark">Tangent</h1>
        </div>
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <div class="hero-copy">
          <p class="lede">{t.hero.lede}</p>
          <div class="cta-row">
            <DownloadButton label={t.download} />
            <a class="btn btn-ghost btn-lg" href="#how">{t.hero.secondary}</a>
          </div>
        </div>
      </div>
      <a class="scroll-cue" href="#intro" aria-label={t.hero.scroll}><Icon name="arrow" /></a>
    </section>

    <section id="intro" class="section statement" aria-labelledby="intro-title">
      <div class="narrow" data-reveal>
        <p class="kicker">{t.intro.kicker}</p>
        <h2 id="intro-title">{t.intro.title}</h2>
        <p class="body-lg">{t.intro.body}</p>
      </div>
      <div class="wide" data-reveal><MockApp t={t.mock} /></div>
    </section>

    <section id="how" class="section" aria-labelledby="how-title">
      <div class="narrow center" data-reveal>
        <p class="kicker">{t.how.kicker}</p>
        <h2 id="how-title">{t.how.title}</h2>
      </div>
      <ol class="steps wide">
        {t.how.steps.map((s, i) => (
          <li class="card step" data-reveal style={`--i:${i}`}>
            <span class="step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="features" class="section" aria-labelledby="features-title">
      <div class="narrow center" data-reveal>
        <p class="kicker">{t.features.kicker}</p>
        <h2 id="features-title">{t.features.title}</h2>
      </div>
      <ul class="grid-3 wide">
        {t.features.items.map((f, i) => (
          <li class="card feature" data-reveal style={`--i:${i % 3}`}>
            <span class="feature-icon"><Icon name={f.icon} /></span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="reference" class="section" aria-labelledby="reference-title">
      <div class="ref-split wide">
        <div class="ref-copy" data-reveal>
          <p class="kicker">{t.reference.kicker}</p>
          <h2 id="reference-title">{t.reference.title}</h2>
          <p class="body-lg">{t.reference.body}</p>
        </div>
        <div data-reveal><RefMock t={t.reference} mock={t.mock} /></div>
      </div>
    </section>

    <section id="examples" class="section" aria-labelledby="examples-title">
      <div class="narrow center" data-reveal>
        <p class="kicker">{t.examples.kicker}</p>
        <h2 id="examples-title">{t.examples.title}</h2>
        <p class="body-lg">{t.examples.body}</p>
      </div>
      <ul class="grid-3 wide">
        {t.examples.items.map((e, i) => (
          <li class="card example" data-reveal style={`--i:${i}`}>
            <div class="example-art"><ExampleArt id={e.id} label={`${t.examples.figure} ${e.title}`} /></div>
            <h3>{e.title}</h3>
            <p>{e.detail}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="export" class="section" aria-labelledby="export-title">
      <div class="narrow center" data-reveal>
        <p class="kicker">{t.export.kicker}</p>
        <h2 id="export-title">{t.export.title}</h2>
      </div>
      <dl class="exports wide" data-reveal>
        {t.export.items.map((x, i) => (
          <div class={i === t.export.items.length - 1 ? 'export export-bambu' : 'export'}>
            <dt>{x.name}</dt>
            <dd>{x.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section id="sources" class="section" aria-labelledby="sources-title">
      <div class="narrow center" data-reveal>
        <p class="kicker">{t.sources.kicker}</p>
        <h2 id="sources-title">{t.sources.title}</h2>
        <p class="body-lg">{t.sources.body}</p>
      </div>
      <div class="sources wide" data-reveal>
        {t.sources.groups.map((g) => (
          <div class="source-group">
            <h3 class="mono-label">{g.title}</h3>
            <ul class="pills">{g.items.map((s) => <li>{s}</li>)}</ul>
          </div>
        ))}
      </div>
      <ul class="trust wide">
        {t.sources.trust.map((x, i) => (
          <li data-reveal style={`--i:${i}`}>
            <span class="feature-icon"><Icon name={i === 0 ? 'lock' : 'shield'} /></span>
            <div><h3>{x.title}</h3><p>{x.body}</p></div>
          </li>
        ))}
      </ul>
    </section>

    <section class="final" aria-labelledby="final-title">
      <div class="final-inner" data-reveal>
        <LaunchMark class="final-launch" />
        <h2 id="final-title">{t.final.title}</h2>
        <p class="body-lg">{t.final.body}</p>
        <DownloadButton label={t.download} />
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <a class="brand" href={t.path} aria-label={t.nav.home}><Mark size={24} /><span>Tangent</span></a>
    <nav aria-label={t.nav.label} class="footer-nav">
      {nav.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <div class="footer-lang">
      <span class="mono-label">{t.footer.language}</span>
      <a href={dicts.en.path} hreflang="en" lang="en" aria-current={locale === 'en' ? 'page' : undefined}>English</a>
      <a href={dicts['zh-tw'].path} hreflang="zh-Hant-TW" lang="zh-Hant-TW" aria-current={locale === 'zh-tw' ? 'page' : undefined}>繁體中文</a>
    </div>
  </footer>
</Base>
