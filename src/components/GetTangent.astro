---
// "Get Tangent": the app is free; the download is the installer of the release in public/updates.
import type { Dict } from '../i18n/en';
import { release } from '../lib/release';

interface Props { t: Dict['get'] }
const { t } = Astro.props;
const d = t.download;
---
<section id="get" class="section" aria-labelledby="get-title">
  <div class="narrow center" data-reveal>
    <p class="kicker">{t.kicker}</p>
    <h2 id="get-title">{t.title}</h2>
    <p class="body-lg">{t.body}</p>
  </div>
  <div id="download" class="download wide" data-reveal>
    <div>
      <h3>{d.title}</h3>
      <p>{d.requires.replace('{macos}', release.macos)}</p>
      <p>{d.first}</p>
    </div>
    <div class="download-action">
      <a class="btn btn-primary btn-lg" href={release.dmgUrl} data-download>{d.button}</a>
      <p class="download-version">{d.version} {release.version}</p>
    </div>
  </div>
</section>
