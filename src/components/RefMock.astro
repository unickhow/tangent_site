---
// Reference images, from a real project: the light app icon attached with a short request, refined
// in conversation over six versions into one printable solid. The model is that project's final
// mesh (src/data/mandarin.json, from scripts/extract-model.mjs), drawn at build time from the app's
// three-quarter card view. Plays once when it scrolls in, with the same motions as MockApp.
// On desktop (fine pointer with hover, WebGL, wide screen) a three.js viewer (lib/viewer.ts) takes
// over once the drawn turn has played; everywhere else the drawing is what's shown.
import Mark from './Mark.astro';
import AgentMark from './AgentMark.astro';
import model from '../data/mandarin.json';
import { Box3, Sphere, Vector3 } from 'three';
import { VIEW, makeCamera, shade } from '../lib/refView';
import type { Dict } from '../i18n/en';

interface Props { t: Dict['reference']; mock: Dict['mock'] }
const { t, mock } = Astro.props;

// Projected through the very camera the desktop viewer uses (lib/refView.ts), so the drawing is
// that viewer's first frame and swapping one for the other can't be seen.
const part = model.parts[0];
const base = [1, 3, 5].map((i) => parseInt(part.color.slice(i, i + 2), 16));
const box = new Box3();
part.faces.forEach(({ p }) => [0, 3, 6].forEach((i) => box.expandByPoint(new Vector3(p[i], p[i + 1], p[i + 2]))));
const centre = box.getCenter(new Vector3());
const camera = makeCamera(box.getBoundingSphere(new Sphere()).radius);
const { width: W, height: H } = VIEW;

const tris = part.faces
  .map(({ p, n, e }) => {
    const pts = [0, 3, 6].map((i) => new Vector3(p[i], p[i + 1], p[i + 2]).sub(centre));
    // The triangle's own normal, turned to the side the stored face normal points (a few stored
    // normals are off-plane, and vertex order doesn't follow winding).
    const normal = new Vector3().subVectors(pts[1], pts[0]).cross(new Vector3().subVectors(pts[2], pts[0])).normalize();
    if (normal.dot(new Vector3(...(n as [number, number, number]))) < 0) normal.negate();
    const mid = pts[0].clone().add(pts[1]).add(pts[2]).divideScalar(3);
    return {
      visible: normal.dot(camera.position.clone().sub(mid)) > 0,
      depth: -mid.distanceTo(camera.position),
      xy: pts.map((q) => {
        const v = q.clone().project(camera);
        return [((v.x + 1) / 2) * W, ((1 - v.y) / 2) * H];
      }),
      fill: `rgb(${base.map((c) => Math.round(c * shade(normal))).join(',')})`,
      edge: e === 1,
    };
  })
  .filter((f) => f.visible)
  .sort((a, b) => a.depth - b.depth);
const d = (xy: number[][]) => 'M' + xy.map(([x, y]) => `${x.toFixed(2)} ${y.toFixed(2)}`).join('L') + 'Z';
const edge = `rgba(${VIEW.edge.rgb.join(',')},${VIEW.edge.alpha})`;

const T0 = { user: 200, think: 600, write: 1400, build: 1600, edges: 2300, faces: 2560, reply: 2700, note: 3400 };
const phases = [
  { motion: 'think' as const, from: T0.think, to: T0.write, label: mock.phases[0] },
  { motion: 'write' as const, from: T0.write, to: T0.build, label: mock.phases[1] },
  { motion: 'build' as const, from: T0.build, to: T0.reply, label: mock.phases[2] },
];
const ms = (n: number) => `--t:${n}ms`;
const versions = Array.from({ length: model.versions }, (_, i) => `v${i + 1}`);
---
<figure class="mock mock-ref" data-color={part.color}>
  <div class="mock-window">
    <div class="mock-bar" aria-hidden="true">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="mock-tab"><Mark size={14} />{t.project}</span>
    </div>
    <div class="mock-body">
      <div class="mock-chat" aria-hidden="true">
        <p class="mock-title">{mock.conversation}</p>
        <div class="msg msg-user msg-attach seq" style={ms(T0.user)}>
          <span class="attachment">
            <img src="/ref/app-icon-light.png" alt="" width="40" height="40" />
            <span>{t.file}</span>
          </span>
          {t.user}
        </div>
        <div class="msg msg-agent">
          <Mark size={18} class="msg-avatar seq" style={ms(T0.reply)} />
          <p class="seq" style={ms(T0.reply)}>{t.agent}</p>
        </div>
        <p class="msg-note seq" style={ms(T0.note)}>{t.note}</p>
        <div class="mock-phases">
          {phases.map((p) => (
            <span class="mock-phase" style={`--t:${p.from}ms;--len:${p.to - p.from}ms`}>
              <AgentMark motion={p.motion} size={16} />{p.label}…
            </span>
          ))}
        </div>
      </div>
      <div class="mock-view">
        <div class="ref-stage">
          <svg viewBox={`0 0 ${W} ${H}`} class="mock-model mock-solid" role="img" aria-label={t.label} style={`--edges:${T0.edges}ms;--faces:${T0.faces}ms`}>
            {tris.map((f) => f.edge
              ? <path d={d(f.xy)} class="face" style={`fill:${f.fill};stroke:${edge}`} pathLength="1" />
              : <path d={d(f.xy)} class="face face-smooth" style={`fill:${f.fill};stroke:${f.fill}`} pathLength="1" />)}
          </svg>
          <div class="viewer" data-viewer tabindex="0" role="application" aria-label={t.viewerLabel}></div>
        </div>
        <span class="viewer-hint" aria-hidden="true">{t.viewerHint}</span>
        <span class="mock-size seq" aria-hidden="true" style={ms(T0.reply)}>{part.size.join(' × ')} mm</span>
        <div class="mock-versions seq" style={ms(T0.note)} aria-hidden="true">
          <span>{mock.versions}</span>{versions.map((v, i) => <b class={i === versions.length - 1 ? 'is-current' : undefined}>{v}</b>)}
        </div>
      </div>
    </div>
  </div>
</figure>

<script>
  // Desktop only; phones, tablets, no WebGL, no JavaScript and crawlers keep the drawing.
  const fig = document.querySelector<HTMLElement>('.mock-ref');
  const host = fig?.querySelector<HTMLElement>('[data-viewer]');
  const desktop = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1024px)').matches;
  const webgl = () => {
    try {
      const c = document.createElement('canvas');
      return !!c.getContext('webgl2'); // the viewer's shader needs WebGL 2
    } catch {
      return false;
    }
  };
  // Resolves once the section has scrolled in and its drawn turn has had time to play.
  const played = (el: Element, wait: number) =>
    new Promise<void>((done) => {
      const go = () => setTimeout(done, wait);
      if (el.classList.contains('is-in')) return go();
      const mo = new MutationObserver(() => {
        if (el.classList.contains('is-in')) {
          mo.disconnect();
          go();
        }
      });
      mo.observe(el, { attributes: true, attributeFilter: ['class'] });
    });

  if (fig && host && desktop && webgl()) {
    const io = new IntersectionObserver(
      async (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        try {
          const { mountViewer } = await import('../lib/viewer');
          host.classList.add('is-mounted');
          const [viewer] = await Promise.all([
            mountViewer(host, { url: '/ref/mandarin.glb', color: fig.dataset.color ?? '#f58220', reducedMotion }),
            played(fig.closest('[data-reveal]') ?? fig, reducedMotion ? 0 : 3000),
          ]);
          // The canvas draws the drawing's exact frame on top of it; only once that frame is on
          // screen does the drawing go, so there is never a moment without the model.
          viewer.render();
          fig.classList.add('has-viewer');
          requestAnimationFrame(() => requestAnimationFrame(() => fig.classList.add('viewer-only')));
          fig.querySelector('.mock-solid')?.setAttribute('aria-hidden', 'true');
        } catch {
          host.classList.remove('is-mounted'); // keep the drawing
        }
      },
      { rootMargin: '400px 0px' },
    );
    io.observe(fig);
  }
</script>
