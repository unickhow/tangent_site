---
// The app's launch (tangent/src/components/LaunchScreen.tsx, `LAUNCH`), as pure CSS so it needs no
// script: facets fold in nearest the centre first, the stem grows, the right then left leaf unfold,
// and one light passes over the finished fruit. Reduced motion shows the finished mark.
import { MARK_FACETS, MARK_VIEWBOX } from './brandMarkFacets';
interface Props { class?: string }
const { class: className } = Astro.props;

const LAUNCH = { facetsFrom: 150, facetMs: 950, stem: 1120, leaves: [1200, 1330], sweep: 1600 };
const LEAVES = { right: ['#86C957', '#3F8F2E'], left: ['#6DB845', '#2E6E22'] };
const STEM = '#5A3210';
const [VX, VY, VW, VH] = MARK_VIEWBOX.split(' ').map(Number);
const CX = VX + VW / 2, CY = VY + VH * 0.6;

const facets = MARK_FACETS.map(([d, fill], i) => {
  const n = (d.match(/-?[\d.]+/g) ?? []).map(Number);
  let x = 0, y = 0;
  for (let k = 0; k < n.length; k += 2) { x += n[k]; y += n[k + 1]; }
  x /= n.length / 2; y /= n.length / 2;
  const sweep = `--s:${(LAUNCH.sweep + ((x - VX) / VW) * 320).toFixed(0)}ms`;
  if (fill === STEM) return { d, fill, kind: 'stem', style: `--d:${LAUNCH.stem}ms;${sweep}` };
  const right = LEAVES.right.includes(fill);
  if (right || LEAVES.left.includes(fill))
    return { d, fill, kind: 'leaf', style: `--d:${LAUNCH.leaves[right ? 0 : 1]}ms;--r:${right ? -40 : 40}deg;${sweep}` };
  const delay = LAUNCH.facetsFrom + Math.min(Math.hypot(x - CX, y - CY), 45) * 5.5;
  return {
    d, fill, kind: 'facet',
    style: `--d:${delay.toFixed(0)}ms;--o:${x.toFixed(1)}px ${y.toFixed(1)}px;--tx:${((x - CX) * 1.6).toFixed(1)}px;--ty:${((y - CY) * 1.6).toFixed(1)}px;--r:${((i % 5) - 2) * 28}deg;${sweep}`,
  };
});
---
<svg class:list={['launch-mark', className]} viewBox={MARK_VIEWBOX} aria-hidden="true" focusable="false">
  {facets.map((f) => <path d={f.d} fill={f.fill} stroke={f.fill} stroke-width="0.6" stroke-linejoin="round" class={f.kind} style={f.style} />)}
</svg>
