---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { dicts, hreflang, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = dicts[locale];
const site = Astro.site!;
const url = (p: string) => new URL(p, site).href;
const canonical = url(t.path);
const ogImage = url(`/og-${locale}.png`);
const alternates = (Object.keys(dicts) as Locale[]).map((l) => ({ code: hreflang[l], href: url(dicts[l].path) }));
const other = dicts[t.lang_switch.target as Locale];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Tangent',
  description: t.meta.description,
  applicationCategory: 'DesignApplication',
  operatingSystem: 'macOS',
  inLanguage: ['en', 'zh-TW'],
  url: canonical,
  image: ogImage,
};
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={url('/')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffe6cc" media="(prefers-color-scheme: light)" data-light="#ffe6cc" data-dark="#2a1408" />
    <meta name="theme-color" content="#2a1408" media="(prefers-color-scheme: dark)" data-light="#ffe6cc" data-dark="#2a1408" />
    {/* Before first paint: apply a theme the visitor chose (header switch), so nothing flashes.
        No choice stored means System: the CSS follows prefers-color-scheme live. */}
    <script is:inline data-theme-init>
      try {
        var theme = localStorage.getItem('tangent-theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
            m.content = m.dataset[theme];
          });
          document.querySelector('meta[name="color-scheme"]').content = theme;
        }
      } catch (e) {}
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tangent" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={other.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
    <script>
      // Reveal sections as they scroll in. Without JS (or with reduced motion) everything is simply visible.
      const els = document.querySelectorAll('[data-reveal]');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        els.forEach((el) => io.observe(el));
      }

      // Header gains a backdrop once the hero has scrolled away.
      const header = document.querySelector('.site-header');
      const onScroll = () => header?.classList.toggle('is-stuck', scrollY > 24);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
